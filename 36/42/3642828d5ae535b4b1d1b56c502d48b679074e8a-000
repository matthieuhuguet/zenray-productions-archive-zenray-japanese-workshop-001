#!/usr/bin/env python3
# Original French research synthesis and Japanese examples, 12 October 2026 12:00 Europe/Paris.
import json
from pathlib import Path
from urllib.parse import quote

OUTPUT = Path(__file__).resolve().parent.parent
CHECKED_AT = '12 October 2026'
TUFS = 'https://www.coelang.tufs.ac.jp/mt/ja/gmod/contents/explanation/'
REUSE = 'Copyright retained by publisher. Link and original paraphrase only; no full lesson, illustration or audio copied.'

def source(url, title, publisher, reuse=REUSE):
    return {'url': url, 'title': title, 'publisher': publisher, 'checkedAt': CHECKED_AT, 'license': 'No open license verified', 'reuse': reuse}

def tufs(number, title):
    return source(TUFS + number + '.html', 'TUFS Japanese grammar: ' + title, 'Tokyo University of Foreign Studies')

def imabi(slug, title):
    return source('https://imabi.org/' + quote(slug, safe='-/'), title, 'Seth Coonrod, IMABI')

records = []

def add(identifier, title, level, explanation, ja, reading, fr, prerequisites, sources, aliases=(), domain='grammar', trap='', contrast='', exercise=''):
    records.append({'id': identifier, 'title': title, 'domain': domain, 'level': level,
        'levelBasis': 'Editorial estimate, not an official JLPT item allocation' if level in ['N5','N4','N3','N2','N1'] else 'Cross-level capability or beyond-JLPT domain',
        'aliases': list(aliases), 'explanationFr': explanation,
        'examples': [{'ja':ja,'reading':reading,'fr':fr,'origin':'Original example composed for this research; not a copied source example'}] if ja else [],
        'prerequisites': prerequisites, 'sources':sources, 'status':'reviewed',
        'reviewScope':'Source checked and original editorial review; no native-speaker validation or learner mastery claimed',
        'frenchLearnerTrap':trap,'contrastFr':contrast,'oralPromptFr':exercise,
        'createdAt':CHECKED_AT,'learnerState':'not-assessed'})

add('grammar-copula','です et la phrase nominale','N5','Un nom suivi de です forme un énoncé poli. Pour le nier, employer ではありません ou une variante adaptée au registre. です ne traduit pas tous les emplois français de « être ».','フランス人です。','ふらんすじんです。','Je suis français.',[],[tufs('001','Nです／Nではありません')],['desu','copule'],trap='Ne pas ajouter です à un verbe déjà terminé par ます.',exercise='Dis ta nationalité, puis ce que tu ne fais pas comme métier.')
add('grammar-topic','は et が : thème et information','N5','は pose ce dont on parle, avec un possible contraste; が marque notamment le sujet et peut identifier la personne recherchée. Le choix dépend de la question et du contexte, pas d’une traduction mot à mot.','わたしが予約しました。','わたしがよやくしました。','C’est moi qui ai réservé.',['grammar-copula'],[tufs('002','NはNです')],['wa','ga','thème','sujet'],trap='は se prononce わ comme particule.',exercise='Réponds à « Qui a réservé ? » en insistant sur toi.')
add('grammar-existence','ある et いる','N5','ある décrit en général l’existence des choses; いる celle des personnes et des animaux mobiles. Une plante relève normalement de ある. Les usages animés par le point de vue demandent une étude séparée.','庭に木があります。','にわにきがあります。','Il y a un arbre dans le jardin.',['grammar-topic'],[tufs('005','Nがあります／います')],['arimasu','imasu'],trap='La distinction n’est pas simplement vivant contre non vivant.',exercise='Décris un arbre et un chat dans le jardin.')
add('grammar-counters','Compter avec des classificateurs','N5','Le nombre se combine avec un classificateur lié à ce que l’on compte. Apprendre la lecture entière: 三本 se lit さんぼん. Pour commencer, つ permet de compter beaucoup d’objets, jusqu’à dix.','お茶を二杯ください。','おちゃをにはいください。','Deux tasses de thé, s’il vous plaît.',['grammar-copula'],[tufs('017','助数詞')],['compteurs','助数詞'],trap='Ne pas prévoir une lecture identique de 本 ou 杯 après tous les nombres.',exercise='Commande deux boissons puis trois petits objets.')
add('grammar-polite-nonpast','ます : habitudes et avenir','N5','La forme polie non passée couvre notamment l’habitude et le futur selon le contexte. Pour une action en cours, on utilise souvent ている. La négation polie est ません.','明日、京都に行きます。','あした、きょうとにいきます。','Demain, je vais à Kyoto.',['grammar-topic'],[tufs('023','Vます／Vません')],['masu','non-passé'],trap='Un présent français n’entraîne pas une forme japonaise unique.',exercise='Dis où tu vas demain et ce que tu fais chaque jour.')
add('grammar-i-adjectives','Les adjectifs en い se transforment','N5','Un adjectif en い se nie en remplaçant い par くない. Il peut se terminer par です pour la politesse. いい possède la base よい dans ses transformations: よくない.','この料理は辛くないです。','このりょうりはからくないです。','Ce plat n’est pas piquant.',['grammar-copula'],[tufs('030','Aいです／Aくありません／Aくないです')],['adjectifs i','kunai'],trap='Ne pas dire 辛いじゃない pour une négation neutre ordinaire.',exercise='Dis que ton plat n’est pas piquant.')
add('grammar-verb-groups','Trois familles de verbes','N5','Les godan changent leur dernière syllabe; les ichidan enlèvent る avant plusieurs terminaisons; する et 来る sont irréguliers. Une terminaison en る ne suffit pas à identifier la famille: 帰る est godan.','毎晩、家に帰ります。','まいばん、いえにかえります。','Chaque soir, je rentre chez moi.',['grammar-polite-nonpast'],[tufs('039','動詞の３種類')],['godan','ichidan','irréguliers'],trap='覚える et 帰る ne suivent pas la même transformation.',exercise='Transforme 食べる, 帰る, する et 来る en forme polie.')
add('grammar-te-form','La forme て, point de raccord','N5','La forme て permet d’enchaîner une action ou d’ajouter une construction. Godan: う・つ・る → って; む・ぶ・ぬ → んで; く → いて; ぐ → いで; す → して. 行く donne 行って.','少し待ってください。','すこしまってください。','Attendez un peu, s’il vous plaît.',['grammar-verb-groups'],[tufs('043','Vて（て形）'),tufs('038','普通形の体系')],['forme te','te-form'],exercise='Transforme 待つ, 飲む, 書く et 行く en forme て.')
add('grammar-progressive','ている : action en cours','N5','Avec une action observable dans sa durée, ている décrit son déroulement. Le temps et la politesse portent sur いる: 読んでいます, 読んでいました.','今、音楽を聞いています。','いま、おんがくをきいています。','En ce moment, j’écoute de la musique.',['grammar-te-form'],[tufs('044','Vています（進行）')],['te iru','progressif'],exercise='Dis ce que tu es en train de faire.')
add('grammar-result-state','ている : résultat qui reste','N4','Avec un changement ponctuel, ている décrit souvent l’état qui en résulte: une porte ouverte ou une personne déjà arrivée. 知っている signifie savoir; sa négation ordinaire est 知らない.','ドアが閉まっています。','どあがしまっています。','La porte est fermée.',['grammar-progressive'],[tufs('045','Vています（状態）')],['état résultant','shitte iru'],trap='閉まっている ne signifie pas nécessairement « est en train de se fermer ».',exercise='Décris une porte déjà fermée, puis dis que tu ne sais pas.')
add('grammar-prepared-state','てある : état préparé intentionnellement','N4','Avec un verbe transitif, てある met en avant le résultat d’une action intentionnelle. L’objet devenu état peut prendre が; une préparation accomplie peut aussi garder を selon la construction.','机に資料が置いてあります。','つくえにしりょうがおいてあります。','Les documents sont disposés sur le bureau.',['grammar-result-state'],[tufs('046','Vてあります')],['te aru'],contrast='置いてある laisse entendre une préparation; 置いている décrit un autre cadrage.',exercise='Dis que les documents ont été disposés pour la réunion.')
add('grammar-case-particles','に, で et を : les rôles','N5','Les particules suivent le groupe nominal. に peut marquer un lieu d’existence, une destination ou un destinataire; で le lieu d’une action ou un moyen; を un objet et parfois un trajet.','図書館で本を読みます。','としょかんでほんをよみます。','Je lis un livre à la bibliothèque.',['grammar-topic'],[tufs('053','格助詞')],['ni','de','wo','particules'],trap='Le français « à » ne correspond pas toujours à に.',exercise='Dis que tu lis à la bibliothèque, puis que le livre y est.')
add('grammar-permission','てもいい : demander la permission','N5','て + もいい permet d’accorder ou demander une permission. Ajouter ですか pour la demande polie. L’autorité et la relation influencent la façon de refuser.','ここに座ってもいいですか。','ここにすわってもいいですか。','Puis-je m’asseoir ici ?',['grammar-te-form'],[tufs('058','Vてもいいです')],['temo ii'],exercise='Demande la permission de t’asseoir.')
add('grammar-prohibition','てはいけない : une interdiction','N5','てはいけない exprime qu’une action n’est pas autorisée. La forme adressée directement à quelqu’un peut être forte. À l’oral, ては peut devenir ちゃ; では devient じゃ.','ここで写真を撮ってはいけません。','ここでしゃしんをとってはいけません。','Il est interdit de prendre des photos ici.',['grammar-te-form'],[tufs('059','Vてはいけません')],['te wa ikenai','cha dame'],exercise='Explique une interdiction affichée dans un musée.')
add('grammar-negative-request','ないでください : ne pas faire','N5','La forme négative en ない suivie de でください demande de ne pas effectuer une action. Selon le contexte, elle sert à donner une consigne ou à protéger l’interlocuteur.','無理をしないでください。','むりをしないでください。','Ne vous surmenez pas.',['grammar-verb-groups'],[tufs('060','Vないでください')],['naide kudasai'],exercise='Demande à quelqu’un de ne pas se surmener.')
add('grammar-volitional','よう et おう : proposer ou décider','N4','Ichidan: remplacer る par よう. Godan: passer à la ligne en お puis ajouter う. する → しよう; 来る → こよう. Le contexte sépare la proposition collective d’une résolution personnelle.','一緒に散歩しよう。','いっしょにさんぽしよう。','Allons nous promener ensemble.',['grammar-verb-groups'],[tufs('065','意志形')],['volitif','you','ou'],trap='ましょう n’est pas un futur de remplacement pour tout « je vais ».',exercise='Propose une promenade à un ami.')
add('grammar-desire','たい : vouloir effectuer une action','N5','La base de ます suivie de たい exprime principalement le désir du locuteur. たい se transforme comme un adjectif en い. Pour les désirs d’un tiers, on distingue citation, observation et inférence.','日本語で話したいです。','にほんごではなしたいです。','Je veux parler en japonais.',['grammar-polite-nonpast'],[tufs('067','Vたいです')],['tai','désir'],trap='Ne pas affirmer automatiquement l’état intérieur d’autrui avec たい.',exercise='Dis ce que tu veux faire en japonais.')
add('grammar-potential','La forme potentielle','N4','Godan: dernière syllabe en え + る; ichidan: enlever る et ajouter られる; する → できる; 来る → こられる. が est courant pour l’objet de capacité, mais を demeure possible dans certains usages.','この漢字が読めます。','このかんじがよめます。','Je peux lire ce kanji.',['grammar-verb-groups'],[tufs('074','可能形'),tufs('053','格助詞')],['potentiel','reru','rareru'],trap='La règle « を devient toujours が » est trop absolue.',exercise='Dis que tu peux lire ce kanji, puis que tu ne peux pas venir demain.')
add('grammar-relative-clause','Décrire un nom par une proposition','N4','La proposition se place devant le nom, sans pronom relatif équivalent à « qui » ou « que ». Son verbe prend une forme neutre. Repérer le nom final pour comprendre ce que tout le bloc décrit.','昨日買った本を読んでいます。','きのうかったほんをよんでいます。','Je lis le livre que j’ai acheté hier.',['grammar-verb-groups','grammar-progressive'],[tufs('079','V＋N')],['relative','modification nominale'],trap='L’ordre français du nom et de sa description est inversé.',exercise='Dis « le livre que j’ai acheté hier ».')
add('grammar-nominalization','こと et の : transformer une action en groupe nominal','N4','こと et の peuvent rendre une proposition utilisable comme nom. Ils ne sont pas interchangeables partout: の est fréquent avec perception ou attente; plusieurs constructions fixent こと.','日本語を話すのが好きです。','にほんごをはなすのがすきです。','J’aime parler japonais.',['grammar-relative-clause'],[tufs('080','Vこと・Vの')],['nominalisation','koto','no'],exercise='Dis que tu aimes parler japonais.')
add('grammar-cause','から et ので : donner une raison','N5','から et ので relient une raison à son résultat. ので présente souvent l’explication avec moins d’insistance personnelle. Après un nom ou un adjectif en な, employer なので.','明日は休みなので、散歩します。','あしたはやすみなので、さんぽします。','Comme demain est un jour de repos, je me promène.',['grammar-copula'],[tufs('081','理由')],['kara','node'],exercise='Explique ton programme de demain par une raison.')
add('grammar-concession-noni','のに et けれど : constater un décalage','N4','のに associe un fait à un résultat contraire à l’attente, souvent avec surprise ou regret. けれど introduit une opposition plus souple. Les demandes et intentions en seconde proposition demandent un choix attentif.','練習したのに、間違えました。','れんしゅうしたのに、まちがえました。','Bien que je me sois entraîné, je me suis trompé.',['grammar-verb-groups'],[tufs('082','逆接')],['noni','kedo'],exercise='Exprime une surprise malgré un entraînement.')
add('grammar-condition-to','と : conséquence habituelle','N4','と relie un déclencheur à un résultat régulier ou automatiquement constaté. Une demande ou une décision volontaire dans la suite nécessite souvent une autre construction.','このボタンを押すと、音が出ます。','このぼたんをおすと、おとがでます。','Quand on appuie sur ce bouton, un son est émis.',['grammar-verb-groups'],[tufs('083','条件')],['conditionnel to'],exercise='Explique le fonctionnement d’un bouton.')
add('grammar-condition-tara','たら : une fois la condition réalisée','N4','La forme passée suivie de ら pose une condition, souvent ponctuelle, ou un repère après lequel faire autre chose. La suite peut contenir une invitation ou une demande.','駅に着いたら、電話してください。','えきについたら、でんわしてください。','Appelez-moi quand vous serez arrivé à la gare.',['grammar-te-form'],[tufs('083','条件')],['tara'],exercise='Demande un appel après l’arrivée à la gare.')
add('grammar-condition-ba','ば : relation conditionnelle','N4','Godan: ligne en え + ば; ichidan: enlever る puis れば. する → すれば, 来る → くれば. Les adjectifs en い prennent ければ. L’emploi dépend aussi de la volonté et de la temporalité.','時間があれば、参加します。','じかんがあれば、さんかします。','Si j’ai le temps, je participerai.',['grammar-verb-groups'],[tufs('083','条件')],['ba','kereba'],exercise='Explique ce que tu fais si tu as le temps.')
add('grammar-condition-nara','なら : partir de ce dont on parle','N4','なら prend comme prémisse une information, une hypothèse ou le projet évoqué. Il permet notamment de donner un conseil avant la réalisation de cette prémisse.','京都に行くなら、早く予約したほうがいいです。','きょうとにいくなら、はやくよやくしたほうがいいです。','Si vous comptez aller à Kyoto, mieux vaut réserver tôt.',['grammar-verb-groups'],[tufs('083','条件')],['nara'],exercise='Conseille une réservation à quelqu’un qui envisage Kyoto.')
add('grammar-concessive-temo','ても : même si','N4','ても indique que la seconde proposition reste valable malgré la première. Pour les noms et adjectifs en な, on emploie でも. Les mots interrogatifs permettent d’élargir: 誰が来ても.','雨が降っても、行きます。','あめがふっても、いきます。','Même s’il pleut, j’y vais.',['grammar-te-form'],[tufs('084','譲歩')],['temo','même si'],exercise='Dis que tu y vas même s’il pleut.')
add('grammar-giving','あげる, くれる et もらう','N4','あげる regarde le don vers autrui; くれる le don reçu par moi ou mon cercle; もらう présente le bénéficiaire comme sujet. Même événement, point de vue différent.','友達が写真をくれました。','ともだちがしゃしんをくれました。','Un ami m’a donné une photo.',['grammar-case-particles'],[tufs('085','やりもらい')],['ageru','kureru','morau'],exercise='Décris un cadeau reçu en commençant par ton ami, puis par toi.')
add('grammar-benefactive','てくれる et てもらう : bénéficier d’une action','N4','Après て, les verbes de don décrivent un service ou un bénéfice. てくれる regarde l’acteur; てもらう regarde celui qui reçoit le service. てあげる peut sembler faire sentir une dette si mal employé.','友達が手伝ってくれました。','ともだちがてつだってくれました。','Un ami m’a aidé.',['grammar-giving','grammar-te-form'],[tufs('086','Vてあげます')],['te kureru','te morau'],exercise='Remercie un ami qui t’a aidé.')
add('grammar-direction-change','てくる et ていく : direction et évolution','N4','くる et いく situent un mouvement par rapport au point de vue. Après て, ils peuvent aussi cadrer une évolution venant jusqu’au présent ou se prolongeant à partir de maintenant.','日本語が少し分かってきました。','にほんごがすこしわかってきました。','Je commence à comprendre un peu le japonais.',['grammar-te-form'],[tufs('087','Vていきます／Vてきます')],['te kuru','te iku'],exercise='Décris une compréhension qui progresse jusqu’à maintenant.')
add('grammar-preparation','ておく : préparer à l’avance','N4','ておく présente une action faite en prévision d’un usage futur. L’objectif, même implicite, compte. À l’oral familier, ておく peut se contracter en とく.','明日の資料を読んでおきます。','あしたのしりょうをよんでおきます。','Je lis les documents de demain à l’avance.',['grammar-te-form'],[tufs('088','Vておきます／Vてみます')],['te oku'],exercise='Dis ce que tu prépares pour demain.')
add('grammar-trying','てみる : essayer en faisant','N4','てみる consiste à effectuer une action pour voir son résultat. Il diffère d’une tentative qui n’aboutit pas, souvent exprimée par la forme volitive + とする.','この靴を履いてみてもいいですか。','このくつをはいてみてもいいですか。','Puis-je essayer ces chaussures ?',['grammar-te-form','grammar-permission'],[tufs('088','Vておきます／Vてみます')],['te miru'],exercise='Demande à essayer des chaussures.')
add('grammar-only','だけ et しかない : limiter','N4','だけ limite directement. しか exige une négation et présente ce qui reste comme seule possibilité. Le choix peut ajouter une impression de manque, selon le contexte.','千円しかありません。','せんえんしかありません。','Je n’ai que mille yens.',['grammar-polite-nonpast'],[tufs('095','副助詞')],['dake','shika'],exercise='Dis que tu n’as que mille yens.')
add('grammar-final-particles','よ et ね : relation à l’interlocuteur','N5','よ présente notamment une information à l’attention de l’autre; ね recherche ou marque un partage, une confirmation ou une appréciation. L’intonation et la relation changent l’effet.','この店は静かですね。','このみせはしずかですね。','Cet endroit est calme, n’est-ce pas ?',['grammar-copula'],[tufs('096','終助詞')],['yo','ne','aizuchi'],trap='Ce ne sont pas de simples décorations de fin de phrase.',exercise='Partage une observation sur un endroit calme.')
add('grammar-honorific','敬語 : qui parle de qui à qui ?','N3','Distinguer la politesse envers l’auditeur, l’élévation de la personne décrite et l’abaissement de sa propre action envers autrui. Le groupe interne ou externe à la situation influence le choix.','先生はもういらっしゃいました。','せんせいはもういらっしゃいました。','Le professeur est déjà arrivé.',['grammar-polite-nonpast'],[tufs('092','敬語')],['keigo','sonkeigo','kenjougo'],exercise='Annonce poliment l’arrivée d’un professeur.')

add('grammar-wake','わけだ : une conclusion qui s’explique','N3','わけだ relie un fait à une explication logique: après avoir appris une information, on comprend pourquoi une situation observée existe. Il se distingue d’une simple prédiction très probable en はずだ.','十年住んでいるんですね。日本語が上手なわけです。','じゅうねんすんでいるんですね。にほんごがじょうずなわけです。','Vous y vivez depuis dix ans. Cela explique votre bon japonais.',['grammar-result-state'],[imabi('わけだ/','わけだ')],['wake da'],exercise='Explique pourquoi quelqu’un parle bien après dix ans sur place.')
add('grammar-wari','わりに : résultat inattendu par rapport au degré','N3','わりに compare un résultat à ce que l’on attend d’un état ou d’une caractéristique. Après un nom, employer のわりに. La comparaison peut porter sur une qualité générale.','この部屋は広いわりに、家賃が安いです。','このへやはひろいわりに、やちんがやすいです。','Le loyer est bas pour une pièce aussi grande.',['grammar-i-adjectives'],[imabi('considering-わりに（は）-にしては/','Considering: わりに（は） & にしては')],['wari ni'],exercise='Compare une grande pièce à son loyer étonnamment bas.')
add('grammar-nishitewa','にしては : compte tenu d’un repère concret','N3','にしては confronte une personne, un montant ou une situation bien définie à une attente. Il ne suit pas directement un adjectif en い pour exprimer son degré; comparer alors avec わりに.','初めてにしては、上手にできました。','はじめてにしては、じょうずにできました。','Pour une première fois, c’est bien réussi.',['grammar-wari'],[imabi('considering-わりに（は）-にしては/','Considering: わりに（は） & にしては')],['ni shite wa'],exercise='Commente une première tentative réussie.')
add('grammar-monono','ものの : concéder sans résultat attendu','N2','ものの reconnaît la première proposition tout en présentant une suite qui déçoit ou limite l’attente. Il est fréquent dans l’écrit et le discours construit.','予約したものの、まだ確認のメールが来ません。','よやくしたものの、まだかくにんのめーるがきません。','Bien que j’aie réservé, je n’ai toujours pas reçu de confirmation.',['grammar-concession-noni'],[imabi('combination-particles-with-もの/','Combination Particles with もの')],['mono no'],exercise='Explique une réservation sans confirmation.')
add('grammar-kaneru','かねる : difficulté ou refus retenu','N2','Base de ます + かねる exprime une impossibilité ou une réticence selon le cas. Il sert souvent à refuser poliment dans un contexte formel; son emploi n’est pas identique à toute incapacité physique.','その質問には答えかねます。','そのしつもんにはこたえかねます。','Je ne suis pas en mesure de répondre à cette question.',['grammar-potential'],[imabi('potential-iv/','Potential IV')],['kaneru'],exercise='Refuse poliment de répondre à une question.')
add('grammar-kanenai','かねない : un risque réel','N2','Base de ます + かねない envisage que quelque chose puisse se produire, surtout une conséquence regrettable. Malgré ない, l’ensemble exprime une possibilité, et non son absence.','このままでは、データが消えかねません。','このままでは、でーたがきえかねません。','À ce rythme, les données risquent de disparaître.',['grammar-kaneru'],[imabi('potential-iv/','Potential IV')],['kanenai'],trap='Ne pas traduire par « ne peut pas ».',exercise='Signale un risque de perte des données.')
add('grammar-zaru','ざるを得ない : ne pas avoir le choix','N2','La base négative sans ない + ざるを得ない indique une nécessité imposée malgré la préférence du sujet. する donne せざるを得ない. La formulation est plus soutenue que しかない.','予定を変更せざるを得ません。','よていをへんこうせざるをえません。','Nous sommes contraints de modifier le programme.',['grammar-verb-groups','grammar-only'],[imabi('～ざるを得ない-やむを得ない/','～ざるを得ない & やむを得ない')],['zaru o enai'],exercise='Annonce un changement imposé par les circonstances.')
add('grammar-totan','たとたんに : au moment même où','N2','La forme passée + とたんに souligne une succession immédiate, souvent une conséquence soudaine. Comparer や否や, plus écrit et pouvant évoquer une action prête à se déclencher.','ドアを開けたとたんに、風が入ってきました。','どあをあけたとたんに、かぜがはいってきました。','Au moment où j’ai ouvert la porte, le vent est entré.',['grammar-te-form'],[source('https://www.jpf.go.jp/j/project/japanese/teach/tsushin/grammar/200906.html','文法を楽しく: とたん（に）とや否や','The Japan Foundation')],['totan ni'],exercise='Raconte un vent soudain après l’ouverture d’une porte.')
add('grammar-yainaya','や否や : à peine une action survenue','N1','Verbe de dictionnaire + や否や décrit une succession immédiate dans un registre surtout écrit. Il peut donner l’impression que la suite attendait le déclencheur. Ne pas réduire la nuance à un simple すぐ.','知らせを聞くや否や、彼は出発しました。','しらせをきくやいなや、かれはしゅっぱつしました。','À peine a-t-il entendu la nouvelle qu’il est parti.',['grammar-totan'],[source('https://www.jpf.go.jp/j/project/japanese/teach/tsushin/grammar/200906.html','文法を楽しく: とたん（に）とや否や','The Japan Foundation')],['ya inaya'],exercise='Raconte un départ immédiat après une nouvelle.')
add('grammar-toiedomo','といえども : même une exception apparente','N1','といえども concède un statut ou un fait sans lui permettre d’annuler ce qui suit. Sa couleur est soutenue et parfois ancienne; dans une conversation ordinaire, une paraphrase plus simple peut convenir.','専門家といえども、間違えることはあります。','せんもんかといえども、まちがえることはあります。','Même un spécialiste peut se tromper.',['grammar-concessive-temo'],[imabi('the-particles-ども-だの/','The Particles ども, とも, & たりとも')],['to iedomo'],exercise='Reconnais que même un expert peut se tromper.')
add('grammar-itaru','に至るまで : étendre jusqu’au détail','N1','Nom + に至るまで porte la portée d’un ensemble jusqu’à une borne ou un détail remarquable. Le registre est construit; il ne remplace pas mécaniquement tous les emplois de まで.','道具から小さな部品に至るまで、すべて確認しました。','どうぐからちいさなぶひんにいたるまで、すべてかくにんしました。','Nous avons tout vérifié, des outils aux petites pièces.',['grammar-case-particles'],[imabi('defining-parameter/','Defining Parameter')],['ni itaru made'],exercise='Décris un contrôle qui va jusqu’aux petites pièces.')
add('grammar-yoginaku','を余儀なくされる : contrainte subie','N1','Nom d’action + を余儀なくされる présente une action imposée par des circonstances. La personne ou l’organisation touchée est le sujet; la cause de la contrainte se formule à part.','大雨のため、旅行の中止を余儀なくされました。','おおあめのため、りょこうのちゅうしをよぎなくされました。','Les fortes pluies nous ont contraints à annuler le voyage.',['grammar-zaru'],[source('https://www.mlcjapanese.co.jp/n1_04_07.html','JLPT N1: を余儀なくされる','MLC Meguro Language Center')],['o yoginaku sareru'],exercise='Annonce une annulation imposée par de fortes pluies.')
add('grammar-mademonai','までもない : inutile d’aller jusque-là','N1','Verbe de dictionnaire + までもない indique que l’action n’est pas nécessaire. 言うまでもない et 言うまでもなく servent à présenter une évidence, selon leur place dans la phrase.','もう分かりました。説明するまでもありません。','もうわかりました。せつめいするまでもありません。','J’ai compris. Il n’est pas nécessaire d’expliquer.',['grammar-verb-groups'],[source('https://www.mlcjapanese.co.jp/n1_04_11.html','JLPT N1: までもない','MLC Meguro Language Center')],['made mo nai'],exercise='Dis qu’une explication supplémentaire n’est pas nécessaire.')
add('grammar-womotte-means','をもって : moyen dans un registre formel','N1','Nom + をもって présente un moyen, un fondement ou une ressource dans une formulation officielle. Ne pas en faire le remplacement courant de で pour les transports, le téléphone ou les objets ordinaires.','書面をもって結果を通知します。','しょめんをもってけっかをつうちします。','Nous communiquerons le résultat par écrit.',['grammar-case-particles'],[source('https://www.mlcjapanese.co.jp/img/omotte_n1_answer.pdf','N1: をもって, answer notes','MLC Meguro Language Center')],['wo motte','moyen formel'],exercise='Annonce une notification officielle par écrit.')

add('method-can-do','Apprendre avec un résultat concret','all','Définir ce que l’on veut réussir dans une situation: obtenir un billet, expliquer un retard, relancer une discussion. La grammaire sert cet acte; une leçon réussie finit par une réalisation observable.','もう一度、ゆっくりお願いします。','もういちど、ゆっくりおねがいします。','Encore une fois, lentement, s’il vous plaît.',[],[source('https://www.irodori.jpf.go.jp/assets/data/resources/Grammar_Worksheets_Answer.pdf','How to Use Grammar Worksheets','The Japan Foundation')],['Can-do','tâche'],domain='methodology',exercise='Obtiens une répétition plus lente dans un échange simulé.')
add('method-retrieval','Rappeler sans regarder, puis corriger','all','Une restitution avant de revoir la réponse révèle les oublis. Une expérience sur des textes montre un bénéfice des tests différés; l’application au japonais est une décision pédagogique, non la preuve d’un calendrier magique.','昨日、何をしましたか。','きのう、なにをしましたか。','Qu’avez-vous fait hier ?',[],[source('https://pubmed.ncbi.nlm.nih.gov/16507066/','Test-enhanced learning: taking memory tests improves long-term retention','Roediger & Karpicke, Psychological Science, 2006')],['récupération active','retest'],domain='methodology',exercise='Sans modèle, dis trois actions d’hier; regarde ensuite la correction.')
add('method-jlpt-scope','N1 reste un niveau de compréhension évaluée','all','Les niveaux officiels décrivent surtout lecture et écoute. N1 inclut textes complexes et discours à vitesse naturelle. Le diplôme ne mesure pas directement toute l’aisance orale, l’écriture ni une spécialité professionnelle.','この文章の結論は何ですか。','このぶんしょうのけつろんはなんですか。','Quelle est la conclusion de ce texte ?',[],[source('https://www.jlpt.jp/sp/e/about/levelsummary.html','N1-N5: Summary of Linguistic Competence Required for Each Level','The Japan Foundation and JEES'),source('https://www.jlpt.jp/sp/e/faq/','JLPT FAQ','The Japan Foundation and JEES')],['limites JLPT','lecture','écoute'],domain='curriculum',exercise='Sépare une réussite de lecture d’une réussite de conversation.')
add('method-no-official-list','Les listes N5 à N1 sont des repères éditoriaux','all','Le JLPT actuel ne publie pas de liste exhaustive officielle de grammaire, vocabulaire ou kanji. Un corpus peut classer des notions par difficulté, mais doit annoncer que cette allocation est estimée et garder ses lacunes visibles.','','','',[],[source('https://www.jlpt.jp/tw/reference/pdf/guidebook_s_e.pdf','New JLPT Guidebook, FAQ about Test Content Specifications','The Japan Foundation and JEES')],['couverture','niveau estimé'],domain='curriculum')
add('beyond-keigo-five','Au-delà du raccourci « trois keigo »','beyond-N1','Les directives officielles distinguent 尊敬語, 謙譲語I, 謙譲語II (丁重語), 丁寧語 et 美化語. Apprendre qui est honoré et envers qui l’action est présentée avant de mémoriser une formule.','明日、伺います。','あした、うかがいます。','Je viendrai vous rendre visite demain.',['grammar-honorific'],[source('https://www.bunka.go.jp/seisaku/bunkashingikai/kokugo/hokoku/pdf/keigo_tosin.pdf','敬語の指針','Agency for Cultural Affairs, Council for Cultural Affairs')],['keigo cinq catégories','humilité I','humilité II'],domain='pragmatics',exercise='Identifie la personne respectée dans une visite annoncée avec 伺う.')
add('beyond-register-choice','Choisir son registre selon la relation','beyond-N1','Les directives sur le keigo placent le respect mutuel et le choix lié à la situation au centre. Le registre dépend des personnes et de la scène; il ne se réduit pas à augmenter mécaniquement la longueur des phrases.','少しお時間をいただけますか。','すこしおじかんをいただけますか。','Pourriez-vous m’accorder un peu de temps ?',['grammar-honorific'],[source('https://www.bunka.go.jp/seisaku/kokugo_nihongo/kokugo_shisaku/keigo/chapter1/detail.html','敬語の心得: understanding check','Agency for Cultural Affairs')],['relation','registre','pragmatique'],domain='pragmatics',exercise='Demande du temps à un collègue proche puis à un client.')

payload={'schemaVersion':1,'title':'Original Japanese language research records','createdAt':CHECKED_AT,
    'scope':'Concrete sample corpus across N5-N1 plus methodology and pragmatics; deliberately not claimed exhaustive.',
    'records':records,
    'coverageGaps':['No exhaustive N1 grammar curriculum proven.','No complete vocabulary or kanji corpus supplied.','No learner mastery asserted.','Examples have editorial review but no native-speaker recording or independent validation.','No French-speaker comparative phonetics experiment performed.','Reading, writing and listening need authentic source tasks beyond these example sentences.']}
OUTPUT.joinpath('LanguageRecords.json').write_text(json.dumps(payload,ensure_ascii=False,indent=2)+'\n')
lines=['# Japanese language research, 12 October 2026','',
    'Original explanations and examples prepared on 12 October 2026. This sample is not an exhaustive N5-N1 curriculum. Item levels are editorial estimates, and publication does not mean that the learner has acquired them.','',
    'The authoritative JLPT guide declines to publish exhaustive item lists. Preserve that distinction in every coverage meter. Sources retain copyright; this deliverable links to them and writes its own examples instead of copying lessons.','']
for record in records:
    lines += ['## '+record['title']+' ('+record['level']+', 12 October 2026)','',record['explanationFr']+' (12 October 2026)','']
    for example in record['examples']:
        lines += [example['ja']+' ('+example['reading']+') : '+example['fr']+' (12 October 2026)','']
    if record['frenchLearnerTrap']: lines += ['Point de vigilance : '+record['frenchLearnerTrap']+' (12 October 2026)','']
    if record['oralPromptFr']: lines += ['À voix haute, sans écrire : '+record['oralPromptFr']+' (12 October 2026)','']
    lines += ['Sources : '+', '.join('['+s['title']+']('+s['url']+')' for s in record['sources'])+'. Vérifiées le 12 October 2026.','']
lines += ['## Coverage gaps, 12 October 2026','']+[x+' (12 October 2026)' for x in payload['coverageGaps']]
OUTPUT.joinpath('LanguageResearch.md').write_text('\n'.join(lines)+'\n')
assert len({r['id'] for r in records})==len(records)
assert all(r['sources'] for r in records)
assert all(all(e['reading'] and e['fr'] for e in r['examples']) for r in records)
assert not any(char in '\n'.join(lines) for char in ['\u2014','\u2013'])
print(json.dumps({'recordCount':len(records),'json':str(OUTPUT/'LanguageRecords.json'),'markdown':str(OUTPUT/'LanguageResearch.md')}))
