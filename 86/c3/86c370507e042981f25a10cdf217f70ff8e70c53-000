#!/usr/bin/env python3
# 13 October 2026, 09:35 CEST: apply one reviewed correction definition to canonical data and authoring seeds.
import json
from pathlib import Path
root = Path(__file__).resolve().parents[1]
settings = json.loads((root / 'review/CorrectionParameters.json').read_text())
changed = []
def transform(value):
    if isinstance(value, str): return settings['replacements'].get(value, value)
    if isinstance(value, list): return [transform(item) for item in value]
    if isinstance(value, dict):
        result = {key: transform(item) for key, item in value.items()}
        for prerequisite in settings['prerequisiteAdditions'].get(result.get('id'), []):
            if prerequisite not in result.get('prerequisites', []): result.setdefault('prerequisites', []).append(prerequisite)
        return result
    return value
for domain in ['language', 'japan']:
    for path in sorted((root / 'research' / domain).glob('*.json')):
        before = json.loads(path.read_text())
        after = transform(before)
        if before != after:
            snapshot = root / 'review/BeforeCorrections-13-October-2026' / domain / path.name
            snapshot.parent.mkdir(parents=True, exist_ok=True)
            if not snapshot.exists(): snapshot.write_text(json.dumps(before, ensure_ascii=False, indent=2) + '\n')
            path.write_text(json.dumps(after, ensure_ascii=False, indent=2) + '\n')
            changed.append(str(path))
print(json.dumps({'date': settings['date'], 'changed': changed}))
