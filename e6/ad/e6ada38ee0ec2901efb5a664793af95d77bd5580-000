#!/usr/bin/env python3
# 12 October 2026: source availability is evidence, not a claim of semantic correctness.
import concurrent.futures
import html
import json
import re
import urllib.request
from pathlib import Path

root=Path(__file__).resolve().parents[1]
urls={}
for folder in ['language','japan']:
    for filename in (root/'research'/folder).glob('*.json'):
        data=json.loads(filename.read_text())
        for record in data.get('records',[]) if isinstance(data,dict) else []:
            for source in record.get('sources',[]): urls[source['url']]=source

def check(url):
    try:
        request=urllib.request.Request(url,headers={'User-Agent':'ZenRayJapanese/1.0 source availability check'})
        with urllib.request.urlopen(request,timeout=15) as response:
            body=response.read(120000)
            text=body.decode('utf-8',errors='replace')
            match=re.search(r'<title[^>]*>(.*?)</title>',text,re.I|re.S)
            return {'url':url,'status':response.status,'title':html.unescape(re.sub(r'\s+',' ',match.group(1))).strip() if match else '', 'finalUrl':response.url}
    except Exception as error: return {'url':url,'error':str(error),'status':None}

with concurrent.futures.ThreadPoolExecutor(max_workers=12) as pool:
    results=list(pool.map(check,sorted(urls)))
(root/'research'/'SourceAvailability.json').write_text(json.dumps(results,ensure_ascii=False,indent=2)+'\n')
print(json.dumps({'sources':len(results),'reachable':sum(r['status']==200 for r in results),'unavailable':[r for r in results if r['status']!=200]},ensure_ascii=False))
