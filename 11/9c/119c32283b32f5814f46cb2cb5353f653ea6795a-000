// 15 October 2026, 10:03 CEST: read-only release proof, including actual deployed code and data paths.
import { readFile, readdir, writeFile } from 'node:fs/promises'
import { createHash } from 'node:crypto'
import assert from 'node:assert/strict'
const root = '/Users/zenray/.claude/tmp/tmp-zenray-japanese'
const dist = process.argv.find(value => value.startsWith('--dist='))?.slice(7) || '/Users/zenray/.codex/worktrees/japanese-progress/dist'
const base = 'https://zenray-progress.pages.dev'
const credentials = await readFile('/Users/zenray/.claude/Memory1/AGENTS.md', 'utf8')
const secret = credentials.match(/Mot de passe maître du drive ZenRayProgress\s*=\s*`([^`]+)`/)?.[1]
assert(secret, 'Existing authentication unavailable')
async function get(path, auth = true) {
  const response = await fetch(base + path, { headers: auth ? { 'x-zr-auth': secret } : {}, signal: AbortSignal.timeout(60000), cache: 'no-store' })
  assert(response.ok, `Read failed: ${response.status} ${path}`)
  return response
}
async function data(path) {
  const envelope = await (await get('/api/page?action=read&raw=1&path=' + encodeURIComponent('Memory/Japanese/' + path))).json()
  assert(envelope.markdown && !envelope.error && !envelope.missing, 'Missing published file: ' + path)
  return JSON.parse(envelope.markdown)
}
const local = JSON.parse(await readFile('/Users/zenray/.claude/Memory1/Japanese/Site/corpus/catalogue.json', 'utf8'))
const live = await data('Site/corpus/catalogue.json')
assert.deepEqual(live, local)
assert(live.cards.length > 0 && live.cards.every(card => card.lessonValidation?.status === 'approved'))
const coverage = await data('Site/corpus/coverage.json')
assert.equal(coverage.release, live.release)
assert.deepEqual(coverage, JSON.parse(await readFile('/Users/zenray/.claude/Memory1/Japanese/Site/corpus/coverage.json', 'utf8')))
const html = await (await get('/', false)).text()
const entry = html.match(/src="([^\"]*\/assets\/index-[^\"]+\.js)"/)?.[1]
assert(entry, 'Live entry not found')
assert((await readFile(dist + '/index.html', 'utf8')).includes(entry), 'Served entry differs from verified build')
const assets = (await readdir(dist + '/assets')).filter(name => name.startsWith('ZenRayJapanese-') && name.endsWith('.js'))
assert.equal(assets.length, 1)
const localCode = await readFile(dist + '/assets/' + assets[0])
const liveCode = Buffer.from(await (await get('/assets/' + assets[0], false)).arrayBuffer())
assert.equal(createHash('sha256').update(liveCode).digest('hex'), createHash('sha256').update(localCode).digest('hex'))
assert(localCode.toString().includes('1.0.0'), 'Release version absent from deployed Japanese component')
function bucket(value) { let hash = 2166136261; for (const character of value) hash = Math.imul(hash ^ character.codePointAt(0), 16777619) >>> 0; return hash % live.recordShards }
const checked = []
for (const id of [live.cards[0].id, live.cards.at(-1).id, 'kanji-0732b']) {
  const shard = await data(`Site/corpus/releases/${live.release}/records/${String(bucket(id)).padStart(3, '0')}.json`)
  assert(shard.some(record => record.id === id), 'Published record missing: ' + id)
  checked.push(id)
}
const search = await data(`Site/corpus/releases/${live.release}/search/074.json`)
assert(search['𠀋']?.length, 'Supplementary kanji search missing')
const state = await (await get('/api/japanese')).json()
assert.equal(state.state?.schemaVersion, 1)
assert(Array.isArray(state.state.eventIds) && Array.isArray(state.state.gaps) && state.state.progress)
const denied = await fetch(base + '/api/japanese', { signal: AbortSignal.timeout(30000) })
assert.equal(denied.status, 401)
const report = { checkedAt: new Date().toISOString(), version: '1.0.0', release: live.release, cards: live.cards.length, entry, component: assets[0], componentSha256: createHash('sha256').update(liveCode).digest('hex'), exactCatalogue: true, exactCoverage: true, recordPathsRead: checked, supplementarySearch: true, learnerStateRead: true, learnerWrites: 0, unauthenticatedStatus: denied.status, passed: true }
await writeFile(root + '/verification/ReleaseProductionReport.json', JSON.stringify(report, null, 2) + '\n')
console.log(JSON.stringify(report))
