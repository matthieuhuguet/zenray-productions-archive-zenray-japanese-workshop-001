    {
      "record": {
        "id": "expand-change-state-suru",
        "title": "する : rendre quelque chose d’une certaine manière",
        "domain": "grammar",
        "level": "N5",
        "levelBasis": "Local editorial estimate; not an official JLPT item allocation",
        "aliases": [
          "する",
          "change-state-suru"
        ],
        "explanationFr": "Pour modifier l'état de l'objet, employer objetを + adjectif en い sans い + くする : 明るい → 明るくする, rendre lumineux. Une base adjectivale en な ou un nom de résultat prend にする : 静かにする, rendre calme. する indique ici l'action qui produit le changement, tandis que なる décrit le changement de l'élément lui-même : 部屋が静かになる. Ce patron ne constitue pas la conjugaison causative en させる.",
        "frenchLearnerTrap": "Distinguer 部屋を静かにする, rendre la pièce calme, et 部屋が静かになる, la pièce devient calme.",
        "examples": [
          {
            "ja": "部屋を明るくします。",
            "reading": "へやをあかるくします。",
            "fr": "Je rends la pièce plus lumineuse.",
            "origin": "Original example; independent adversarial review pending"
          },
          {
            "ja": "昼は教室を静かにします。",
            "reading": "ひるはきょうしつをしずかにします。",
            "fr": "À midi, je fais en sorte que la salle de classe soit calme.",
            "origin": "Original example; independent adversarial review pending"
