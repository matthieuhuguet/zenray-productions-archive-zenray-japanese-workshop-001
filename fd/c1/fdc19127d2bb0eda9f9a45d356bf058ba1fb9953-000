#!/usr/bin/env python3
# 12 October 2026: compare every original chunk with its pinned remote Git object, without deleting sources.
import concurrent.futures,hashlib,json,re,subprocess,sys,datetime
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]
CACHE=Path('/Users/zenray/Library/Caches/ZenRayJapaneseCloudVerification')
STATE=Path('/Users/zenray/Library/Application Support/ZenRayAssets')
OWNER='matthieuhuguet'

def git(directory,*args):
    return subprocess.run(['git','-C',str(directory),*args],check=True,capture_output=True,timeout=300).stdout

def clone(name):
    assert re.fullmatch(r'[A-Za-z0-9_.-]+',name),'Unsafe repository name'
    directory=CACHE/name
    if not directory.exists():
        subprocess.run(['git','clone','--quiet','--filter=blob:none','--no-checkout',f'https://github.com/{OWNER}/{name}.git',str(directory)],check=True,capture_output=True,timeout=300)
    else:git(directory,'fetch','--quiet','--filter=blob:none','origin','main')
    return directory

CACHE.mkdir(parents=True,exist_ok=True)
data=clone('zenray-data')
git(data,'sparse-checkout','init','--cone')
git(data,'sparse-checkout','set','pages/ZenRayAssets/zenray-japanese/sources')
git(data,'checkout','--quiet','-B','verification','origin/main')
state=json.loads((STATE/'Project-zenray-japanese.json').read_text())
files=state['inventory']['localFiles'];work=[];problems=[];groups=set()
for file in files:
    backup=state['backups'].get(file['id'])
    if not backup:problems.append({'id':file['id'],'reason':'Receipt missing'});continue
    path=data/backup['manifestPath']
    if not path.is_file():problems.append({'id':file['id'],'reason':'Remote manifest missing'});continue
    manifest=json.loads(path.read_text())
    if manifest.get('sha256')!=backup['sha256'] or manifest.get('size')!=file['size']:
        problems.append({'id':file['id'],'reason':'Manifest fingerprint differs'});continue
    assert manifest.get('type')=='file' and manifest.get('mode')=='chunked','Unsupported archive mode'
    parts=manifest.get('parts') or [manifest]
    for part in parts:groups.add((part['repo'],part['commit']))
    work.append((file,backup,manifest,parts))
repositories={}
with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:
    names=sorted({repo for repo,commit in groups})
    repositories=dict(zip(names,pool.map(clone,names)))
trees={}
for repo,commit in sorted(groups):
    assert re.fullmatch('[a-f0-9]{40}',commit),'Unsafe commit'
    directory=repositories[repo]
    try:git(directory,'cat-file','-e',commit+'^{commit}')
    except subprocess.CalledProcessError:git(directory,'fetch','--quiet','--filter=blob:none','origin',commit)
    entries={}
    for row in git(directory,'ls-tree','-r','-z',commit).split(b'\0'):
        if not row:continue
        metadata,path=row.split(b'\t',1)
        mode,kind,sha=metadata.split()
        if kind==b'blob':entries[path.decode()]=sha.decode()
    trees[(repo,commit)]=entries
print(json.dumps({'stage':'remote-trees','repositories':len(repositories),'pinnedCommits':len(trees),'files':len(work)}),flush=True)

def check(item):
    file,backup,manifest,parts=item
    source=Path(file['localPath']);before=source.stat();full=hashlib.sha256();offset=0;chunks=0
    with source.open('rb') as stream:
        for part in parts:
            tree=trees[(part['repo'],part['commit'])]
            for name in part['chunks']:
                size=min(manifest.get('chunkSize',19922944),file['size']-offset)
                payload=stream.read(size)
                if len(payload)!=size:return {'id':file['id'],'reason':'Local size changed'}
                identity=hashlib.sha1(f'blob {size}\0'.encode()+payload).hexdigest()
                if tree.get(name)!=identity:return {'id':file['id'],'reason':'Remote Git object differs','chunk':name}
                full.update(payload);offset+=size;chunks+=1
        if stream.read(1):return {'id':file['id'],'reason':'Local file grew'}
    after=source.stat()
    if (before.st_size,before.st_mtime_ns,before.st_ctime_ns)!=(after.st_size,after.st_mtime_ns,after.st_ctime_ns):return {'id':file['id'],'reason':'Source changed during verification'}
    if offset!=file['size'] or full.hexdigest()!=backup['sha256']:return {'id':file['id'],'reason':'Original fingerprint differs'}
    return {'id':file['id'],'matched':True,'chunks':chunks}
with concurrent.futures.ThreadPoolExecutor(max_workers=4) as pool:results=list(pool.map(check,work))
problems += [item for item in results if not item.get('matched')]
report={'date':datetime.datetime.now().astimezone().strftime('%d %B %Y').lstrip('0'),'inventoryCheckedAt':state['inventory']['checkedAt'],'files':len(files),'matched':sum(bool(item.get('matched')) for item in results),'chunks':sum(item.get('chunks',0) for item in results),'remoteRepositories':len(repositories),'pinnedCommits':len(trees),'complete':not problems,'problems':problems,'sourcesDeleted':False}
if '--no-report' not in sys.argv:(ROOT/'verification/CloudIdentityReport.json').write_text(json.dumps(report,indent=2))
print(json.dumps({key:value for key,value in report.items() if key!='problems'}));print(json.dumps({'problemExamples':problems[:5]}));sys.exit(0 if report['complete'] else 1)
