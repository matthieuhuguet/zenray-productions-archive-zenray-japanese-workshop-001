const root = '/Users/zenray/.claude/tmp/tmp-zenray-japanese'
const credentialSource = await readFile('/Users/zenray/.claude/Memory1/AGENTS.md', 'utf8')
const secret = credentialSource.match(/Mot de passe maître du drive ZenRayProgress\s*=\s*`([^`]+)`/)?.[1]
if (!secret) throw new Error('Existing site credential is unavailable')
const readJson = async path => {
  const response = await fetch(`https://zenray-progress.pages.dev/api/page?action=read&raw=1&path=${encodeURIComponent(path)}`, { headers: { 'x-zr-auth': secret }, signal: AbortSignal.timeout(20000) })
  const result = await response.json()
  if (!response.ok || result.error || result.missing || typeof result.markdown !== 'string') throw new Error(`Live read failed: ${response.status}, ${result.error || 'missing'}`)
  return JSON.parse(result.markdown)
}
const client = createCorpusClient(readJson)
const catalogue = await client.getCatalogue()
const kanji = await client.search('日', { domain: 'kanji' })
