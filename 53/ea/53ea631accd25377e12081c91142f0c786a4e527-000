#!/usr/bin/env python3
# 12 October 2026: test the cloud verifier against Git's independent object hash and corrupted bytes.
import ast,hashlib,json,subprocess,tempfile,unittest
from pathlib import Path
source=Path(__file__).with_name('VerifyCloudIdentity.py')
function=next(node for node in ast.parse(source.read_text()).body if isinstance(node,ast.FunctionDef) and node.name=='check')
namespace={'Path':Path,'hashlib':hashlib,'trees':{}}
exec(compile(ast.Module(body=[function],type_ignores=[]),str(source),'exec'),namespace)
class CloudIdentityContract(unittest.TestCase):
    def test_good_and_corrupted_original(self):
        with tempfile.TemporaryDirectory() as directory:
            path=Path(directory)/'original.txt';payload=b'Cloud proof sample\n';path.write_bytes(payload)
            identity=subprocess.run(['git','hash-object','--stdin'],input=payload,check=True,capture_output=True).stdout.decode().strip()
            namespace['trees']={('test-repo','commit'):{'chunk':identity}}
            record={'id':'sample','localPath':str(path),'size':len(payload)}
            backup={'sha256':hashlib.sha256(payload).hexdigest()}
            manifest={'chunkSize':len(payload)};parts=[{'repo':'test-repo','commit':'commit','chunks':['chunk']}]
            self.assertTrue(namespace['check']((record,backup,manifest,parts))['matched'])
            path.write_bytes(b'Broken proof data\n!')
            self.assertFalse(namespace['check']((record,backup,manifest,parts)).get('matched',False))
            path.write_bytes(payload);namespace['trees']={('test-repo','commit'):{}}
            self.assertFalse(namespace['check']((record,backup,manifest,parts)).get('matched',False))
if __name__=='__main__':unittest.main()
